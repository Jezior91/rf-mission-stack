# RF Mission Stack 6.2 — Konfiguracja
# Uruchom: python gen_env.py  aby wygenerować ten plik z losowymi sekretami

SECRET_KEY=ZMIEN_MNIE_NA_LOSOWY_STRING_MIN_32_ZNAKI
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=ZMIEN_MNIE_NA_SILNE_HASLO

MISSION_URL=http://localhost:8081
API_PORT=8000
MISSION_PORT=8081
P2P_PORT=9000

# FCM (Firebase Cloud Messaging dla Android push)
FCM_SERVER_KEY=TWOJ_KLUCZ_FCM_Z_KONSOLI_FIREBASE

# TLS (opcjonalne — generuj przez auth/ca_gen.py)
TLS_CERT_FILE=certs/server.crt
TLS_KEY_FILE=certs/server.key
